# Cloudflare Wrangler build cache — contains account id/email, must not be committed
.wrangler/

# Local env / secrets
.env
.env.*

# OS / editor junk
.DS_Store
Thumbs.db

# Visual Studio local state
.vs/

# Deletion staging areas - tooling scratch, must never be deployed
_to_delete/
scripts/_to_delete/

# Obsidian vault — project notes, not site content.
# The repo root IS the deployed site, so anything committed here becomes a public URL.
MY-NOTES/

# Python cache
__pycache__/
*.pyc
# Raw cached HTTP responses from fact-gathering. Third-party page content -
# never commit to a public repo. Evidence substrings live in the .json sheets.
docs/facts/_fetches/

# OMC session state - local tooling scratch, never site content
.omc/

# Generated publication artifact; source manuscripts remain in reviews/.
.public-site/
